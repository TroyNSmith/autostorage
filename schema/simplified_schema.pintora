@pre
@style {
  .calculation {
    backgroundColor: #44BB99;
  }
  .model {
    backgroundColor: #DDDDDD;
  }
  .geometry {
    backgroundColor: #99DDFF;
  }
  .trajectory {
    backgroundColor: #BBCC33;
  }
  .result {
    backgroundColor: #77AADD;
  }
  .stationary {
    backgroundColor: #EE8866;
  }
  .stage {
    backgroundColor: #FFAABB;
  }
  .step {
    backgroundColor: #AA4499;
  }
}
@endpre

erDiagram
    %% Universal styling
    @param stroke #000000
    @param labelBackground #FFFFFF
    @param fontSize 36
    @param fontFamily "Georgia"
    @param entityPaddingX 30
    @param entityPaddingY 30
    @param ranksep 150
    @param edgesep 175

    %% Style binds
    @bindClass entity-model model
    @bindClass entity-calculation calculation
    @bindClass entity-geometry geometry
    @bindClass entity-trajectory trajectory
    @bindClass entity-property_kind result
    @bindClass entity-property_value result
    @bindClass entity-stationary_point stationary
    @bindClass entity-identity_algorithm stationary
    @bindClass entity-identity stationary
    @bindClass entity-stage stage
    @bindClass entity-step step
    @bindClass entity-validation step

    %% Attributes
    model {
    string program
    string method
    string basis
    }
    calculation {
    enum calc_type
    json input_provenance
    json output_provenance
    }
    geometry {
    json symbols
    blob coordinates
    int charge
    int spin
    }
    property_kind {
    string name
    }
    property_value {
    blob value
    }
    stationary_point {
    int order
    bool is_pseudo
    bool is_validated
    }
    identity_algorithm {
    string name
    enum kind
    }
    identity {
    string value
    }
    stage {
    bool is_ts
    }
    step {
    bool is_barrierless
    }
    validation {
    }


    %% Entity Relationships
    model }o--|| calculation : "specifies"

    calculation }o--o{ geometry : "I/O"
    calculation }o--o{ trajectory : "I/O"
    calculation ||..o{ property_value : "produces"
    calculation ||..o{ stationary_point : "produces"
    calculation ||..o{ validation : "performs"

    geometry }o--o{ trajectory : "member of"
    property_value }o..|| geometry : "from"
    property_value }o--|| property_kind : "of kind"

    stationary_point }o..|| geometry : "has"
    stationary_point }o--o{ identity : "has"
    stationary_point }o--o{ stage : "species of"

    identity }o--|| identity_algorithm : "generated by"
    identity_algorithm }o--o| identity_algorithm : "parent"
    
    stage ||..o{ step : "node of"

    validation }o--o{ step : "validates"